diff --git a/tests/server/mcpserver/test_tool_manager.py b/tests/server/mcpserver/test_tool_manager.py
index 221828c..802b391 100644
--- a/tests/server/mcpserver/test_tool_manager.py
+++ b/tests/server/mcpserver/test_tool_manager.py
@@ -904,3 +904,84 @@ class TestRemoveTools:
         # Remove with correct case
         manager.remove_tool("test_func")
         assert manager.get_tool("test_func") is None
+
+
+def test_tool_manager_has_tool_true_for_registered_name():
+    """ToolManager.has_tool reports True for an exactly-matching registered name."""
+
+    def add(a: int, b: int) -> int:
+        """Add two numbers."""
+        return a + b
+
+    manager = ToolManager()
+    manager.add_tool(add)
+
+    assert manager.has_tool("add") is True
+
+
+def test_tool_manager_has_tool_false_for_missing_empty_and_miscased_names():
+    """ToolManager.has_tool is case-sensitive and rejects missing and empty names."""
+
+    def add(a: int, b: int) -> int:  # pragma: no cover
+        """Add two numbers."""
+        return a + b
+
+    manager = ToolManager()
+    manager.add_tool(add)
+
+    assert manager.has_tool("addition") is False
+    assert manager.has_tool("") is False
+    assert manager.has_tool("Add") is False
+
+
+def test_tool_manager_has_tool_false_after_removal():
+    """ToolManager.has_tool reports False for a name that was removed."""
+
+    def add(a: int, b: int) -> int:  # pragma: no cover
+        """Add two numbers."""
+        return a + b
+
+    manager = ToolManager()
+    manager.add_tool(add)
+    manager.remove_tool("add")
+
+    assert manager.has_tool("add") is False
+
+
+def test_tool_manager_has_tool_does_not_mutate_or_execute():
+    """ToolManager.has_tool inspects membership without running or changing the tool."""
+
+    calls: list[int] = []
+
+    def record(x: int) -> int:
+        """Record the call and echo the value."""
+        calls.append(x)
+        return x
+
+    manager = ToolManager()
+    manager.add_tool(record)
+    before = manager.list_tools()
+
+    assert manager.has_tool("record") is True
+    assert manager.has_tool("missing") is False
+
+    assert calls == []
+    assert manager.list_tools() == before
+
+
+def test_mcpserver_has_tool_delegates_to_manager():
+    """MCPServer.has_tool mirrors its ToolManager, including case sensitivity and removal."""
+    app = MCPServer()
+
+    @app.tool()
+    def greet(name: str) -> str:
+        """Greet someone."""
+        return f"Hello, {name}!"
+
+    assert app.has_tool("greet") is True
+    assert app.has_tool("Greet") is False
+    assert app.has_tool("") is False
+    assert app.has_tool("missing") is False
+
+    app.remove_tool("greet")
+    assert app.has_tool("greet") is False
