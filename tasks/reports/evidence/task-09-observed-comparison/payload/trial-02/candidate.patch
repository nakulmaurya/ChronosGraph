diff --git a/tests/server/mcpserver/test_tool_manager.py b/tests/server/mcpserver/test_tool_manager.py
index 221828c..c810d22 100644
--- a/tests/server/mcpserver/test_tool_manager.py
+++ b/tests/server/mcpserver/test_tool_manager.py
@@ -904,3 +904,72 @@ class TestRemoveTools:
         # Remove with correct case
         manager.remove_tool("test_func")
         assert manager.get_tool("test_func") is None
+
+
+def test_tool_manager_has_tool_true_for_registered_name():
+    def greet(name: str) -> str:  # pragma: no cover
+        """Greet someone."""
+        return f"Hello, {name}!"
+
+    manager = ToolManager()
+    manager.add_tool(greet)
+
+    assert manager.has_tool("greet") is True
+
+
+def test_tool_manager_has_tool_false_for_missing_empty_and_wrong_case():
+    def register_user(user_id: int) -> int:  # pragma: no cover
+        """Register a user."""
+        return user_id
+
+    manager = ToolManager()
+    manager.add_tool(register_user)
+
+    assert manager.has_tool("missing") is False
+    assert manager.has_tool("") is False
+    assert manager.has_tool("Register_User") is False
+
+
+def test_tool_manager_has_tool_false_after_removal():
+    def greet(name: str) -> str:  # pragma: no cover
+        """Greet someone."""
+        return f"Hello, {name}!"
+
+    manager = ToolManager()
+    manager.add_tool(greet)
+    manager.remove_tool("greet")
+
+    assert manager.has_tool("greet") is False
+
+
+def test_tool_manager_has_tool_does_not_mutate_or_execute():
+    calls: list[int] = []
+
+    def tracked(x: int) -> int:
+        calls.append(x)
+        return x
+
+    manager = ToolManager()
+    manager.add_tool(tracked)
+
+    assert manager.has_tool("tracked") is True
+    assert manager.has_tool("tracked") is True
+    assert calls == []
+    assert [tool.name for tool in manager.list_tools()] == ["tracked"]
+
+
+def test_mcpserver_has_tool_delegates_to_manager():
+    app = MCPServer()
+
+    @app.tool()
+    def echo(message: str) -> str:  # pragma: no cover
+        """Echo a message back."""
+        return message
+
+    assert app.has_tool("echo") is True
+    assert app.has_tool("missing") is False
+    assert app.has_tool("Echo") is False
+    assert app.has_tool("") is False
+
+    app.remove_tool("echo")
+    assert app.has_tool("echo") is False
