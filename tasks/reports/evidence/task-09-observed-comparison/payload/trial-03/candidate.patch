+# Tests for ToolNameValidationResult.invalid_characters
+
+
+def test_invalid_characters_exposes_unique_chars_in_first_seen_order() -> None:
+    """Invalid characters should be unique and preserve first-seen order."""
+    result = validate_tool_name("user name@domain,com")
+    assert result.invalid_characters == [" ", "@", ","]
+
+
+def test_invalid_characters_deduplicates_repeated_characters() -> None:
+    """Repeated invalid characters should appear only once."""
+    result = validate_tool_name("a/b/c")
+    assert result.invalid_characters == ["/"]
+
+
+def test_invalid_characters_includes_unicode() -> None:
+    """Unicode characters should be exposed verbatim."""
+    result = validate_tool_name("user-\u00f1ame\u4e2d")
+    assert result.invalid_characters == ["\u00f1", "\u4e2d"]
+
+
+@pytest.mark.parametrize(
+    "tool_name",
+    ["getUser", "get_user_profile", "a", "a" * 128],
+    ids=["simple_alphanumeric", "with_underscores", "single_character", "max_length_128"],
+)
+def test_invalid_characters_empty_for_valid_names(tool_name: str) -> None:
+    """Valid names should expose an empty list of invalid characters."""
+    result = validate_tool_name(tool_name)
+    assert result.is_valid is True
+    assert result.invalid_characters == []
+
+
+def test_invalid_characters_empty_for_empty_name() -> None:
+    """The empty-name early return should expose an empty list."""
+    result = validate_tool_name("")
+    assert result.invalid_characters == []
+
+
+def test_invalid_characters_empty_for_overlength_name() -> None:
+    """The overlength early return should expose an empty list."""
+    result = validate_tool_name("a" * 129)
+    assert result.invalid_characters == []
+
+
+def test_tool_name_validation_result_supports_two_positional_arguments() -> None:
+    """Existing two-positional-argument construction must keep working."""
+    result = ToolNameValidationResult(True, [])
+    assert result.is_valid is True
+    assert result.warnings == []
+    assert result.invalid_characters == []
+
+
+def test_tool_name_validation_result_invalid_characters_default_is_independent() -> None:
+    """The default list must not be shared between instances."""
+    first = ToolNameValidationResult(True, [])
+    second = ToolNameValidationResult(True, [])
+    first.invalid_characters.append("/")
+    assert second.invalid_characters == []
+
+
 # Tests for validate_tool_name function - warnings for problematic patterns
 
 
