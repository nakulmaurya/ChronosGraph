  "declared_rationale": "Docs-only change: add a docstring to client.py:timeout_result recording that existing queue workers (worker.py:should_retry) require the returned {'ok': False, 'reason': 'timeout'} envelope. ADR-002 (ACTIVE) mandates retaining that envelope, and INC-007 explains the retry branch bypass that motivated it; both govern any future exception migration. No runtime behavior, callers, tests, or policies are changed. Human approval remains pending.",
  "rationale_provenance": "AGENT_DECLARED_NOT_HIDDEN_REASONING",
  "base_file_shas": {
    "client.py": "0606750cfac544988e19204c945a74391effe821ead28bc731ddbdc21def7be6"
  },
  "proposed_files": {
    "client.py": "\"\"\"Owned synthetic organization example, not a reported upstream defect.\"\"\"\ndef timeout_result():\n    \"\"\"Return the timeout envelope required by existing queue workers.\n\n    Existing queue workers depend on this ``{'ok': False, 'reason': 'timeout'}``\n    envelope. ADR-002 and INC-007 govern any future migration to exceptions.\n    \"\"\"\n    return {'ok': False, 'reason': 'timeout'}\n"
  },
